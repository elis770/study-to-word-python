# batch_export_refs.py
import time, os, requests, urllib.parse, json

BASE = "https://www.sefaria.org/api/v3/texts/"
OUT_DIR = "batch_output"
os.makedirs(OUT_DIR, exist_ok=True)

def fetch_one(ref):
    url = BASE  +  urllib.parse.quote(ref, safe='')
    r = requests.get(url, headers={"Accept":"application/json"})
    r.raise_for_status()
    return r.json()

with open("refs.txt", "r", encoding="utf-8") as f:
    refs = [line.strip() for line in f if line.strip()]

for i, ref in enumerate(refs, 1):
    try:
        data = fetch_one(ref)
        fname = ref.replace(" ", "_").replace(",", "").replace(":", "_")
        with open(os.path.join(OUT_DIR, f"{fname}.json"), "w", encoding="utf-8") as out:
            json.dump(data, out, ensure_ascii=False, indent=2)
        print(f"[{i}/{len(refs)}] saved {ref}")
    except Exception as e:
        print("ERROR for", ref, e)
    time.sleep(0.6)   # be polite — small delay between requests
