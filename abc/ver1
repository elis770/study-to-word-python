# fetch_rambam_passage.py
import requests
import urllib.parse
import json
import os

def fetch_text(tref, version=None, language=None, context=0):
    """
    Fetch a text from Sefaria v3 texts endpoint.
    tref: e.g. "Mishneh Torah, Repentance 1:1" or "Mishneh Torah, Repentance"
    version: e.g. "english" or "hebrew" or "english|Birnbaum"
    language: optional language preference (e.g. "he" or "en")
    context: 0 to suppress surrounding context when requesting a single segment
    """
    base = "https://www.sefaria.org/api/v3/texts/"
    url = base  +  urllib.parse.quote(tref, safe='')
    params = {}
    if version:
        params['version'] = version
    if language:
        params['language'] = language
    if context is not None:
        params['context'] = context

    headers = {"Accept": "application/json"}
    r = requests.get(url, params=params, headers=headers)
    r.raise_for_status()
    return r.json()

def save_json(obj, filename):
    with open(filename, "w", encoding="utf-8") as f:
        json.dump(obj, f, ensure_ascii=False, indent=2)

def save_plain_text(text_array, filename):
    # text_array is typically a list of strings (segments)
    with open(filename, "w", encoding="utf-8") as f:
        if isinstance(text_array, list):
            for seg in text_array:
                f.write(seg  +  "\n")
        else:
            f.write(str(text_array))

if __name__ == "__main__":
    TREF = "Mishneh Torah, Repentance 1:1"   # change this to your desired ref
    VERSION = None   # e.g. "english" or "hebrew" or "en|Birnbaum"
    OUT_DIR = "output"
    os.makedirs(OUT_DIR, exist_ok=True)

    data = fetch_text(TREF, version=VERSION, language=None, context=0)
    safe_name = TREF.replace(" ", "_").replace(",", "").replace(":", "_")
    save_json(data, f"{OUT_DIR}/{safe_name}.json")

    # many responses have 'text' (english) and 'he' (hebrew) fields — adjust as needed:
    en_text = data.get("text")       # usually list of strings (English)
    he_text = data.get("he")         # Hebrew text (if present)

    if en_text:
        save_plain_text(en_text, f"{OUT_DIR}/{safe_name}.en.txt")
    if he_text:
        save_plain_text(he_text, f"{OUT_DIR}/{safe_name}.he.txt")

    print("Saved:", OUT_DIR)
